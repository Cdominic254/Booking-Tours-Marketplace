SECRET_KEY=replace-with-a-long-random-secret
FLASK_ENV=production
FLASK_DEBUG=false
SESSION_COOKIE_SECURE=true
SITE_URL=https://kenyabook.com
DATABASE_URL=postgresql://user:password@host:5432/kenyabook
RATELIMIT_STORAGE_URI=rediss://user:password@host:6379/0
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USERNAME=
EMAIL_PASSWORD=
EMAIL_FROM=
EMAIL_TO=info@kenyabook.com
EMAIL_USE_TLS=true
EMAIL_USE_SSL=false
# Country code first, digits only: the number becomes the wa.me recipient.
WHATSAPP_BUSINESS_PHONE=254704143718
# Official @safarinasstay profiles are used when a value is blank. Set a
# variable to a non-URL value (for example "off") to hide that network; a row
# of share buttons is always shown instead.
SOCIAL_INSTAGRAM_URL=https://www.instagram.com/safarinasstay/
SOCIAL_FACEBOOK_URL=https://www.facebook.com/safarinasstay
SOCIAL_X_URL=https://x.com/safarinasstay
SOCIAL_TIKTOK_URL=https://www.tiktok.com/@safarinasstay
SOCIAL_YOUTUBE_URL=https://www.youtube.com/@safarinasstay
DARAJA_ENV=sandbox
DARAJA_CONSUMER_KEY=
DARAJA_CONSUMER_SECRET=
DARAJA_SHORTCODE=
DARAJA_PASSKEY=
DARAJA_CALLBACK_URL=https://kenyabook.com/daraja/callback
