      "html": "<style>\n@import url('https://fonts.googleapis.com/css2?family=Inter:wght@400&family=Geist+Mono:wght@400&display=swap');\n@import url('https://cdn.jsdelivr.net/npm/@fortawesome/fontawesome-free@7.3.1/css/all.min.css');\n@import url('https://cdn.jsdelivr.net/npm/lucide-static@1.48.0/font/lucide.css');\n.auth-preview { font-family: 'Inter', sans-serif; font-weight: 400; color: #fff; background: #0a0a0a; }\n.auth-preview .mono-label { font-family: 'Geist Mono', monospace; font-weight: 400; }\n.auth-preview a, .auth-preview button, .auth-preview input { -webkit-tap-highlight-color: transparent; }\n.auth-preview a:focus-visible, .auth-preview button:focus-visible, .auth-preview input:focus-visible { outline: 2px solid #fff; outline-offset: 4px; }\n.auth-preview .outline-control { border: 1px solid rgba(255,255,255,.25); border-radius: 9999px; color: #fff; transition: background-color 150ms cubic-bezier(.2,0,0,1), border-color 150ms cubic-bezier(.2,0,0,1); }\n.auth-preview .outline-control:hover { background: #1a1c20; border-color: rgba(255,255,255,.52); }\n.auth-preview .destination-link { transition: color 150ms cubic-bezier(.2,0,0,1); }\n.auth-preview .destination-link:hover { color: #fff; text-decoration: underline; text-underline-offset: 5px; }\n.auth-preview input { color-scheme: dark; }\n.auth-preview .method-form { position: relative; }\n.auth-preview .method-form::before { content: ''; position: absolute; left: -33px; top: 0; bottom: 0; width: 1px; background: #212327; }\n.auth-preview #mobile-navigation[hidden] { display: none; }\n@media (max-width: 1023px) { .auth-preview .method-form::before { display: none; } }\n</style>\n<div class=\"auth-preview min-h-[900px] w-full\" data-kid=\"1\" data-name=\"page layout container\">\n<header class=\"border-b border-[#212327]\" data-kid=\"1-1\" data-name=\"site header bar\">\n<div class=\"mx-auto flex h-[88px] max-w-[1248px] items-center justify-between gap-6 px-6 max-sm:h-[72px]\" data-kid=\"1-1-1\" data-name=\"header content row\">\n<a aria-label=\"Lamu Tours home\" class=\"flex shrink-0 items-center gap-3 rounded-full\" data-kid=\"1-1-1-1\" data-name=\"site logo link\" href=\"/index.html\">\n<img alt=\"\" class=\"h-10 w-10 rounded-lg\" data-kid=\"1-1-1-1-1\" data-name=\"site logo icon image\" decoding=\"async\" height=\"40\" loading=\"lazy\" src=\"/api/local/images/logo.svg\" width=\"40\"/>\n<span class=\"text-[18px] tracking-[-0.5px]\" data-kid=\"1-1-1-1-2\" data-name=\"site brand name text\">Lamu Tours</span>\n</a>\n<nav aria-label=\"Main navigation\" class=\"hidden items-center gap-0.5 text-[13px] lg:flex\" data-kid=\"1-1-1-2\" data-name=\"main desktop navigation\">\n<a class=\"destination-link inline-flex h-10 items-center rounded-full px-3 text-[#dadbdf]\" data-en=\"Home\" data-kid=\"1-1-1-2-1\" data-name=\"nav link home\" data-sw=\"Nyumbani\" href=\"/index.html\">Home</a>\n<a class=\"destination-link inline-flex h-10 items-center rounded-full px-3 text-[#dadbdf]\" data-en=\"Tours\" data-kid=\"1-1-1-2-2\" data-name=\"nav link tours\" data-sw=\"Ziara\" href=\"/tours.html\">Tours</a>\n<a class=\"destination-link inline-flex h-10 items-center rounded-full px-3 text-[#dadbdf]\" data-en=\"Plan your trip\" data-kid=\"1-1-1-2-3\" data-name=\"nav link plan your trip\" data-sw=\"Panga safari\" href=\"/booking.html\">Plan your trip</a>\n<a class=\"destination-link inline-flex h-10 items-center rounded-full px-3 text-[#dadbdf]\" data-en=\"About Lamu\" data-kid=\"1-1-1-2-4\" data-name=\"nav link about Lamu\" data-sw=\"Kuhusu Lamu\" href=\"/about-lamu.html\">About Lamu</a>\n<a class=\"destination-link inline-flex h-10 items-center rounded-full px-3 text-[#dadbdf]\" data-en=\"Contact\" data-kid=\"1-1-1-2-5\" data-name=\"nav link contact\" data-sw=\"Wasiliana nasi\" href=\"/contact.html\">Contact</a>\n<a aria-current=\"page\" class=\"ml-2 inline-flex h-10 items-center rounded-full bg-[#1a1c20] px-4 text-white\" data-en=\"Sign in\" data-kid=\"1-1-1-2-6\" data-name=\"nav link sign in (current page)\" data-sw=\"Ingia\" href=\"/login.html\">Sign in</a>\n<a class=\"outline-control ml-2 inline-flex h-10 items-center justify-center px-4\" data-en=\"My account\" data-kid=\"1-1-1-2-7\" data-name=\"nav link my account\" data-sw=\"Akaunti yangu\" href=\"/my-bookings\">My account</a>\n<button aria-label=\"Switch to Kiswahili\" class=\"language-toggle outline-control ml-2 inline-flex h-10 items-center justify-center px-4 text-[13px]\" data-kid=\"1-1-1-2-8\" data-name=\"language toggle button\" type=\"button\">Kiswahili</button>\n</nav>\n<button aria-controls=\"mobile-navigation\" aria-expanded=\"false\" class=\"outline-control inline-flex h-11 items-center gap-2 px-4 text-sm lg:hidden\" data-kid=\"1-1-1-3\" data-name=\"mobile menu toggle button\" id=\"menu-toggle\" type=\"button\">\n<i aria-hidden=\"true\" class=\"icon-menu inline-flex h-4 w-4 items-center justify-center text-base text-white\" data-dynamic=\"true\" data-kid=\"1-1-1-3-1\" data-name=\"menu hamburger/x icon\" data-reason=\"icon class and menu glyph swapped by menu toggle script on click\" id=\"menu-icon\"></i>\n<span data-en=\"Menu\" data-kid=\"1-1-1-3-2\" data-name=\"menu button label\" data-sw=\"Menyu\">Menu</span>\n</button>\n</div>\n<nav aria-label=\"Mobile navigation\" class=\"border-t border-[#212327] px-6 pb-5 pt-3 lg:hidden\" data-kid=\"1-1-2\" data-name=\"mobile navigation panel\" hidden=\"\" id=\"mobile-navigation\">\n<div class=\"mx-auto flex max-w-[1200px] flex-col gap-1 text-sm\" data-kid=\"1-1-2-1\" data-name=\"mobile nav link list\">\n<a class=\"destination-link flex min-h-11 items-center rounded-full px-3 text-[#dadbdf]\" data-en=\"Home\" data-kid=\"1-1-2-1-1\" data-name=\"mobile nav link home\" data-sw=\"Nyumbani\" href=\"/index.html\">Home</a>\n<a class=\"destination-link flex min-h-11 items-center rounded-full px-3 text-[#dadbdf]\" data-en=\"Tours\" data-kid=\"1-1-2-1-2\" data-name=\"mobile nav link tours\" data-sw=\"Ziara\" href=\"/tours.html\">Tours</a>\n<a class=\"destination-link flex min-h-11 items-center rounded-full px-3 text-[#dadbdf]\" data-en=\"Plan your trip\" data-kid=\"1-1-2-1-3\" data-name=\"mobile nav link plan your trip\" data-sw=\"Panga safari\" href=\"/booking.html\">Plan your trip</a>\n<a class=\"destination-link flex min-h-11 items-center rounded-full px-3 text-[#dadbdf]\" data-en=\"About Lamu\" data-kid=\"1-1-2-1-4\" data-name=\"mobile nav link about Lamu\" data-sw=\"Kuhusu Lamu\" href=\"/about-lamu.html\">About Lamu</a>\n<a class=\"destination-link flex min-h-11 items-center rounded-full px-3 text-[#dadbdf]\" data-en=\"Contact\" data-kid=\"1-1-2-1-5\" data-name=\"mobile nav link contact\" data-sw=\"Wasiliana nasi\" href=\"/contact.html\">Contact</a>\n<a aria-current=\"page\" class=\"flex min-h-11 items-center rounded-full bg-[#1a1c20] px-3 text-white\" data-en=\"Sign in\" data-kid=\"1-1-2-1-6\" data-name=\"mobile nav link sign in (current page)\" data-sw=\"Ingia\" href=\"/login.html\">Sign in</a>\n<a class=\"destination-link flex min-h-11 items-center rounded-full px-3 text-[#dadbdf]\" data-en=\"My account\" data-kid=\"1-1-2-1-7\" data-name=\"mobile nav link my account\" data-sw=\"Akaunti yangu\" href=\"/my-bookings\">My account</a>\n<button aria-label=\"Switch to Kiswahili\" class=\"language-toggle outline-control mt-2 min-h-11 self-start px-4\" data-kid=\"1-1-2-1-8\" data-name=\"mobile language toggle button\" type=\"button\">Kiswahili</button>\n</div>\n</nav>\n</header>\n<main class=\"mx-auto max-w-[1008px] px-6 pb-12 pt-[72px] max-lg:max-w-[544px] max-lg:pt-10 max-sm:pb-8 max-sm:pt-8\" data-kid=\"1-2\" data-name=\"main sign-in content\">\n<div class=\"lg:px-6\" data-kid=\"1-2-1\" data-name=\"sign-in heading block\">\n<p class=\"mono-label text-xs uppercase leading-4 tracking-[1.2px] text-[#dadbdf]\" data-en=\"Traveler account\" data-kid=\"1-2-1-1\" data-name=\"sign-in section eyebrow label\" data-sw=\"Akaunti ya msafiri\">Traveler account</p>\n<h1 class=\"mt-3 text-[48px] leading-[1.08] tracking-[-1.6px] max-sm:text-[32px] max-sm:leading-[1.13] max-sm:tracking-[-1px]\" data-en=\"Sign in\" data-kid=\"1-2-1-2\" data-name=\"page headline Sign in\" data-sw=\"Ingia\">Sign in</h1>\n<div class=\"mt-6 rounded-lg border border-[#363a3f] bg-[#191919] px-4 py-3 text-sm leading-6 text-[#dadbdf]\" data-kid=\"1-2-1-3\" data-name=\"error alert container\" hidden=\"\" id=\"auth-error\" role=\"alert\"></div>\n</div>\n<div class=\"mt-9 grid gap-6 lg:grid-cols-[352px_448px] lg:gap-16 lg:px-6 max-sm:mt-6\" data-kid=\"1-2-2\" data-name=\"auth options grid\">\n<section aria-label=\"GitHub sign-in\" data-kid=\"1-2-2-1\" data-name=\"GitHub sign-in section\">\n<button class=\"outline-control flex h-12 w-full items-center justify-center gap-3 px-5 text-sm\" data-kid=\"1-2-2-1-1\" data-name=\"GitHub sign-in button\" id=\"github-sign-in\" type=\"button\">\n<i aria-hidden=\"true\" class=\"fa-brands fa-github inline-flex h-5 w-5 items-center justify-center text-[20px] text-white\" data-kid=\"1-2-2-1-1-1\" data-name=\"GitHub brand icon\"></i>\n<span data-en=\"Continue with GitHub\" data-kid=\"1-2-2-1-1-2\" data-name=\"GitHub sign-in button label\" data-sw=\"Endelea na GitHub\">Continue with GitHub</span>\n</button>\n<div class=\"mt-8 hidden flex-col items-start gap-3 text-sm leading-6 lg:flex\" data-kid=\"1-2-2-1-2\" data-name=\"GitHub section help links column\">\n<a class=\"destination-link inline-flex min-h-6 items-center gap-2 rounded-full text-white\" data-kid=\"1-2-2-1-2-1\" data-name=\"create account link with arrow\" href=\"/register.html\">\n<span data-en=\"Create an account\" data-kid=\"1-2-2-1-2-1-1\" data-name=\"create account link label\" data-sw=\"Fungua akaunti\">Create an account</span>\n<i aria-hidden=\"true\" class=\"icon-arrow-up-right inline-flex h-4 w-4 items-center justify-center text-base text-[#dadbdf]\" data-kid=\"1-2-2-1-2-1-2\" data-name=\"arrow up-right icon\"></i>\n</a>\n<a class=\"destination-link rounded-full text-[#dadbdf]\" data-en=\"View or manage your bookings\" data-kid=\"1-2-2-1-2-2\" data-name=\"view manage bookings link\" data-sw=\"Angalia au simamia nafasi ulizohifadhi\" href=\"/my-bookings\">View or manage your bookings</a>\n</div>\n</section>\n<div aria-hidden=\"true\" class=\"flex items-center gap-4 lg:hidden\" data-kid=\"1-2-2-2\" data-name=\"or divider (mobile)\">\n<span class=\"h-px flex-1 bg-[#212327]\" data-kid=\"1-2-2-2-1\" data-name=\"divider left line\"></span>\n<span class=\"mono-label text-[11px] leading-4 tracking-[1.2px] text-[#7d8187]\" data-en=\"OR\" data-kid=\"1-2-2-2-2\" data-name=\"or divider label\" data-sw=\"AU\">OR</span>\n<span class=\"h-px flex-1 bg-[#212327]\" data-kid=\"1-2-2-2-3\" data-name=\"divider right line\"></span>\n</div>\n<form action=\"/login\" class=\"method-form\" data-kid=\"1-2-2-3\" data-name=\"email password login form\" id=\"traveler-login\" method=\"post\">\n<div data-kid=\"1-2-2-3-1\" data-name=\"email field wrapper\">\n<label class=\"mono-label block text-xs uppercase leading-4 tracking-[1.2px] text-[#dadbdf]\" data-en=\"Email address\" data-kid=\"1-2-2-3-1-1\" data-name=\"email address label\" data-sw=\"Anwani ya barua pepe\" for=\"traveler-email\">Email address</label>\n<input autocomplete=\"email\" class=\"mt-2 h-12 w-full rounded-full border border-[#212327] bg-[#1a1c20] px-5 text-base text-white outline-offset-4\" data-kid=\"1-2-2-3-1-2\" data-name=\"email address input field\" id=\"traveler-email\" name=\"email\" required=\"\" spellcheck=\"false\" type=\"email\"/>\n</div>\n<div class=\"mt-6 max-sm:mt-4\" data-kid=\"1-2-2-3-2\" data-name=\"password field wrapper\">\n<label class=\"mono-label block text-xs uppercase leading-4 tracking-[1.2px] text-[#dadbdf]\" data-en=\"Password\" data-kid=\"1-2-2-3-2-1\" data-name=\"password label\" data-sw=\"Nenosiri\" for=\"traveler-password\">Password</label>\n<input autocomplete=\"current-password\" class=\"mt-2 h-12 w-full rounded-full border border-[#212327] bg-[#1a1c20] px-5 text-base text-white outline-offset-4\" data-kid=\"1-2-2-3-2-2\" data-name=\"password input field\" id=\"traveler-password\" name=\"password\" required=\"\" type=\"password\"/>\n</div>\n<button class=\"outline-control mt-6 flex h-12 w-full items-center justify-center px-5 text-sm\" data-en=\"Sign in\" data-kid=\"1-2-2-3-3\" data-name=\"form submit sign-in button\" data-sw=\"Ingia\" type=\"submit\">Sign in</button>\n</form>\n<div class=\"flex flex-col items-start gap-1 text-sm leading-6 lg:hidden\" data-kid=\"1-2-2-4\" data-name=\"GitHub section help links (mobile)\">\n<a class=\"destination-link inline-flex min-h-11 items-center gap-2 rounded-full text-white\" data-kid=\"1-2-2-4-1\" data-name=\"create account link with arrow\" href=\"/register.html\">\n<span data-en=\"Create an account\" data-kid=\"1-2-2-4-1-1\" data-name=\"create account link label\" data-sw=\"Fungua akaunti\">Create an account</span>\n<i aria-hidden=\"true\" class=\"icon-arrow-up-right inline-flex h-4 w-4 items-center justify-center text-base text-[#dadbdf]\" data-kid=\"1-2-2-4-1-2\" data-name=\"arrow up-right icon\"></i>\n</a>\n<a class=\"destination-link inline-flex min-h-11 items-center rounded-full text-[#dadbdf]\" data-en=\"View or manage your bookings\" data-kid=\"1-2-2-4-2\" data-name=\"view manage bookings link\" data-sw=\"Angalia au simamia nafasi ulizohifadhi\" href=\"/my-bookings\">View or manage your bookings</a>\n</div>\n</div>\n<section aria-label=\"Vendor access\" class=\"mt-14 border-t border-[#212327] pt-6 lg:mx-6 max-sm:mt-6\" data-kid=\"1-2-3\" data-name=\"vendor access section\">\n<div class=\"flex flex-wrap items-center justify-between gap-4\" data-kid=\"1-2-3-1\" data-name=\"vendor access header row\">\n<h2 class=\"mono-label text-xs uppercase leading-4 tracking-[1.2px] text-[#dadbdf]\" data-en=\"Vendor access\" data-kid=\"1-2-3-1-1\" data-name=\"vendor access heading\" data-sw=\"Ufikiaji wa mtoa huduma\">Vendor access</h2>\n<div class=\"flex flex-wrap gap-3\" data-kid=\"1-2-3-1-2\" data-name=\"vendor action links group\">\n<a class=\"outline-control inline-flex min-h-11 items-center justify-center px-5 text-sm\" data-en=\"Vendor sign in\" data-kid=\"1-2-3-1-2-1\" data-name=\"vendor sign-in link\" data-sw=\"Ingia kama mtoa huduma\" href=\"/vendor/login\">Vendor sign in</a>\n<a class=\"outline-control inline-flex min-h-11 items-center justify-center px-5 text-sm\" data-en=\"Create a vendor account\" data-kid=\"1-2-3-1-2-2\" data-name=\"vendor account creation link\" data-sw=\"Fungua akaunti ya mtoa huduma\" href=\"/vendor/register\">Create a vendor account</a>\n</div>\n</div>\n</section>\n</main>\n<footer class=\"mx-auto mt-[112px] max-w-[1200px] px-6 pb-8 text-center text-xs leading-5 text-[#7d8187] max-lg:mt-8 max-sm:mt-0\" data-kid=\"1-3\" data-name=\"footer bar\">\n    © 2026 Lamu Tours &amp; Booking Agency. All rights reserved.\n  </footer>\n</div>\n<script>\n(function () {\n  var root = document.querySelector('.auth-preview');\n  var menu = root.querySelector('#mobile-navigation');\n  var menuButton = root.querySelector('#menu-toggle');\n  var menuIcon = root.querySelector('#menu-icon');\n  menuButton.addEventListener('click', function () {\n    var isOpen = menuButton.getAttribute('aria-expanded') === 'true';\n    menuButton.setAttribute('aria-expanded', String(!isOpen));\n    menu.hidden = isOpen;\n    menuIcon.classList.toggle('icon-menu', isOpen);\n    menuIcon.classList.toggle('icon-x', !isOpen);\n  });\n  root.querySelector('#traveler-login').addEventListener('submit', function (event) {\n    event.preventDefault();\n  });\n  root.querySelector('#github-sign-in').addEventListener('click', function (event) {\n    event.preventDefault();\n  });\n  var errorText = new URLSearchParams(window.location.search).get('error');\n  if (errorText) {\n    var errorBox = root.querySelector('#auth-error');\n    var errorIcon = document.createElement('i');\n    errorIcon.className = 'icon-circle-alert mr-2 inline-flex h-4 w-4 items-center justify-center text-base text-white';\n    errorIcon.setAttribute('aria-hidden', 'true');\n    errorBox.appendChild(errorIcon);\n    errorBox.appendChild(document.createTextNode(errorText));\n    errorBox.hidden = false;\n  }\n  var language = 'en';\n  root.querySelectorAll('.language-toggle').forEach(function (button) {\n    button.addEventListener('click', function () {\n      language = language === 'en' ? 'sw' : 'en';\n      root.setAttribute('lang', language);\n      root.querySelectorAll('[data-en][data-sw]').forEach(function (element) {\n        element.textContent = element.getAttribute('data-' + language);\n      });\n      root.querySelectorAll('.language-toggle').forEach(function (toggle) {\n        toggle.textContent = language === 'en' ? 'Kiswahili' : 'English';\n        toggle.setAttribute('aria-label', language === 'en' ? 'Switch to Kiswahili' : 'Switch to English');\n      });\n    });\n  });\n})();\n</script>",
