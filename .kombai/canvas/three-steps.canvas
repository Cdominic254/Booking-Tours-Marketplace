      "html": "<style>\n@import url('https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Playfair+Display:wght@500;600&display=swap');\n@import url('https://cdn.jsdelivr.net/npm/lucide-static@1.48.0/font/lucide.css');\n</style>\n<div class=\"min-h-full w-full bg-[#f2f8fc] text-[#18344b]\" data-kid=\"1\" data-name=\"page layout container\" style=\"font-family:'DM Sans',ui-sans-serif,sans-serif\">\n<section class=\"mx-auto max-w-[1180px] px-5 py-20 sm:px-8\" data-kid=\"1-1\" data-name=\"sample day section container\">\n<div class=\"grid gap-10 lg:grid-cols-[280px_1fr] lg:gap-14\" data-kid=\"1-1-1\" data-name=\"day overview grid with sidebar and timeline\">\n<div data-kid=\"1-1-1-1\" data-name=\"sidebar intro block\">\n<h2 class=\"text-[2.5rem] leading-[1.08] text-[#18344b]\" data-kid=\"1-1-1-1-1\" data-name=\"day overview headline\" style=\"font-family:'Playfair Display',Georgia,serif;font-weight:600;letter-spacing:-0.03em\">Your first day in Lamu</h2>\n<p class=\"mt-5 leading-7 text-[#18344b]/80\" data-kid=\"1-1-1-1-2\" data-name=\"day overview description text\">Old Town lanes in the morning, a dhow in the afternoon, a room by the water at dusk.</p>\n<a class=\"mt-7 inline-flex items-center gap-2 rounded-md bg-[#eaf5fb] px-4 py-2.5 text-sm font-semibold text-[#083b66] transition-colors hover:bg-[#dbedf7]\" data-kid=\"1-1-1-1-3\" data-name=\"all tours link button\" href=\"/tours.html\">\n          All tours\n          <span class=\"text-sm\" data-kid=\"1-1-1-1-3-1\" data-name=\"arrow icon wrapper\"><i class=\"icon-arrow-right\" data-kid=\"1-1-1-1-3-1-1\" data-name=\"right arrow icon\"></i></span>\n</a>\n</div>\n<div class=\"flex flex-col\" data-kid=\"1-1-1-2\" data-name=\"itinerary timeline column\">\n<article class=\"grid grid-cols-[56px_16px_1fr] gap-x-4 py-5\" data-kid=\"1-1-1-2-1\" data-name=\"first timeline item (morning)\">\n<div class=\"pt-1.5 text-right\" data-kid=\"1-1-1-2-1-1\" data-name=\"first item time label column\">\n<span class=\"text-[1.05rem] font-semibold tracking-[0.1em]\" data-kid=\"1-1-1-2-1-1-1\" data-name=\"first item time text 07:00\" style=\"font-family:'Playfair Display',Georgia,serif\">07:00</span>\n</div>\n<div class=\"relative flex justify-center\" data-kid=\"1-1-1-2-1-2\" data-name=\"first item timeline dot column\">\n<span class=\"absolute -top-5 -bottom-5 w-px bg-[#cfe0e9]\" data-kid=\"1-1-1-2-1-2-1\" data-name=\"first item timeline vertical line\"></span>\n<span class=\"relative z-10 mt-2 h-2.5 w-2.5 rounded-full bg-[#0e9db0] ring-4 ring-[#f2f8fc]\" data-kid=\"1-1-1-2-1-2-2\" data-name=\"first item timeline dot indicator\"></span>\n</div>\n<div class=\"rounded-lg border border-[#cfe0e9] bg-white p-5\" data-kid=\"1-1-1-2-1-3\" data-name=\"first item activity card\">\n<div class=\"flex flex-wrap items-center justify-between gap-3\" data-kid=\"1-1-1-2-1-3-1\" data-name=\"first item card header row\">\n<h3 class=\"text-[1.35rem] leading-tight\" data-kid=\"1-1-1-2-1-3-1-1\" data-name=\"first item activity title\" style=\"font-family:'Playfair Display',Georgia,serif;font-weight:600;letter-spacing:-0.02em\">Old Town Walk</h3>\n<span class=\"inline-flex items-center gap-1.5 text-xs font-medium text-[#087e9f]\" data-kid=\"1-1-1-2-1-3-1-2\" data-name=\"first item mode badge (on foot)\">\n<span class=\"text-sm\" data-kid=\"1-1-1-2-1-3-1-2-1\" data-name=\"footprints icon wrapper\"><i class=\"icon-footprints\" data-kid=\"1-1-1-2-1-3-1-2-1-1\" data-name=\"footprints icon\"></i></span>\n                On foot\n              </span>\n</div>\n<p class=\"mt-2 leading-6 text-[#18344b]/75\" data-kid=\"1-1-1-2-1-3-2\" data-name=\"first item activity description\">Carved doors, coral-stone lanes and the fort museum, on foot from the waterfront.</p>\n<ul class=\"mt-3 flex flex-wrap items-center divide-x divide-[#e6eef4] text-[0.8rem] text-[#18344b]/70\" data-kid=\"1-1-1-2-1-3-3\" data-name=\"first item activity meta list\">\n<li class=\"pr-3\" data-kid=\"1-1-1-2-1-3-3-1\" data-name=\"first item duration meta\">3 hours</li>\n<li class=\"px-3\" data-kid=\"1-1-1-2-1-3-3-2\" data-name=\"first item price meta\">From KES 3,500</li>\n<li class=\"pl-3\" data-kid=\"1-1-1-2-1-3-3-3\" data-name=\"first item capacity meta\">Max 12 guests</li>\n</ul>\n<a class=\"mt-4 inline-flex items-center gap-1.5 text-sm font-semibold text-[#087e9f] underline-offset-4 hover:underline\" data-kid=\"1-1-1-2-1-3-4\" data-name=\"first item tour detail link\" href=\"/tour-details.html?tour=old-town\">\n              Walk the old town\n              <span class=\"text-sm\" data-kid=\"1-1-1-2-1-3-4-1\" data-name=\"arrow icon wrapper\"><i class=\"icon-arrow-right\" data-kid=\"1-1-1-2-1-3-4-1-1\" data-name=\"right arrow icon\"></i></span>\n</a>\n</div>\n</article>\n<article class=\"grid grid-cols-[56px_16px_1fr] gap-x-4 py-5\" data-kid=\"1-1-1-2-2\" data-name=\"second timeline item (afternoon)\">\n<div class=\"pt-1.5 text-right\" data-kid=\"1-1-1-2-2-1\" data-name=\"second item time label column\">\n<span class=\"text-[1.05rem] font-semibold tracking-[0.1em]\" data-kid=\"1-1-1-2-2-1-1\" data-name=\"second item time text 14:00\" style=\"font-family:'Playfair Display',Georgia,serif\">14:00</span>\n</div>\n<div class=\"relative flex justify-center\" data-kid=\"1-1-1-2-2-2\" data-name=\"second item timeline dot column\">\n<span class=\"absolute -top-5 -bottom-5 w-px bg-[#cfe0e9]\" data-kid=\"1-1-1-2-2-2-1\" data-name=\"second item timeline vertical line\"></span>\n<span class=\"relative z-10 mt-2 h-2.5 w-2.5 rounded-full bg-[#0e9db0] ring-4 ring-[#f2f8fc]\" data-kid=\"1-1-1-2-2-2-2\" data-name=\"second item timeline dot indicator\"></span>\n</div>\n<div class=\"rounded-lg border border-[#cfe0e9] bg-white p-5\" data-kid=\"1-1-1-2-2-3\" data-name=\"second item activity card\">\n<div class=\"flex flex-wrap items-center justify-between gap-3\" data-kid=\"1-1-1-2-2-3-1\" data-name=\"second item card header row\">\n<h3 class=\"text-[1.35rem] leading-tight\" data-kid=\"1-1-1-2-2-3-1-1\" data-name=\"second item activity title\" style=\"font-family:'Playfair Display',Georgia,serif;font-weight:600;letter-spacing:-0.02em\">Dhow &amp; Island Hopping</h3>\n<span class=\"inline-flex items-center gap-1.5 text-xs font-medium text-[#087e9f]\" data-kid=\"1-1-1-2-2-3-1-2\" data-name=\"second item mode badge (by boat)\">\n<span class=\"text-sm\" data-kid=\"1-1-1-2-2-3-1-2-1\" data-name=\"sailboat icon wrapper\"><i class=\"icon-sailboat\" data-kid=\"1-1-1-2-2-3-1-2-1-1\" data-name=\"sailboat icon\"></i></span>\n                By boat\n              </span>\n</div>\n<p class=\"mt-2 leading-6 text-[#18344b]/75\" data-kid=\"1-1-1-2-2-3-2\" data-name=\"second item activity description\">A half day out of Lamu Town to the sandbanks and back, with the crew on the sail.</p>\n<ul class=\"mt-3 flex flex-wrap items-center divide-x divide-[#e6eef4] text-[0.8rem] text-[#18344b]/70\" data-kid=\"1-1-1-2-2-3-3\" data-name=\"second item activity meta list\">\n<li class=\"pr-3\" data-kid=\"1-1-1-2-2-3-3-1\" data-name=\"second item duration meta\">Half day</li>\n<li class=\"px-3\" data-kid=\"1-1-1-2-2-3-3-2\" data-name=\"second item price meta\">KES 8,500</li>\n<li class=\"pl-3\" data-kid=\"1-1-1-2-2-3-3-3\" data-name=\"second item capacity meta\">Max 12 guests</li>\n</ul>\n<a class=\"mt-4 inline-flex items-center gap-1.5 text-sm font-semibold text-[#087e9f] underline-offset-4 hover:underline\" data-kid=\"1-1-1-2-2-3-4\" data-name=\"second item sailings link\" href=\"/booking.html?tour=dhow\">\n              See sailings and dates\n              <span class=\"text-sm\" data-kid=\"1-1-1-2-2-3-4-1\" data-name=\"arrow icon wrapper\"><i class=\"icon-arrow-right\" data-kid=\"1-1-1-2-2-3-4-1-1\" data-name=\"right arrow icon\"></i></span>\n</a>\n</div>\n</article>\n<article class=\"grid grid-cols-[56px_16px_1fr] gap-x-4 py-5\" data-kid=\"1-1-1-2-3\" data-name=\"third timeline item (evening)\">\n<div class=\"pt-1.5 text-right\" data-kid=\"1-1-1-2-3-1\" data-name=\"third item time label column\">\n<span class=\"text-[1.05rem] font-semibold tracking-[0.1em]\" data-kid=\"1-1-1-2-3-1-1\" data-name=\"third item time text 18:30\" style=\"font-family:'Playfair Display',Georgia,serif\">18:30</span>\n</div>\n<div class=\"relative flex justify-center\" data-kid=\"1-1-1-2-3-2\" data-name=\"third item timeline dot column\">\n<span class=\"absolute -top-5 -bottom-5 w-px bg-[#cfe0e9]\" data-kid=\"1-1-1-2-3-2-1\" data-name=\"third item timeline vertical line\"></span>\n<span class=\"relative z-10 mt-2 h-2.5 w-2.5 rounded-full bg-[#d9583f] ring-4 ring-[#f2f8fc]\" data-kid=\"1-1-1-2-3-2-2\" data-name=\"third item timeline dot indicator\"></span>\n</div>\n<div class=\"rounded-lg border border-[#cfe0e9] bg-white p-5\" data-kid=\"1-1-1-2-3-3\" data-name=\"third item stay card\">\n<div class=\"flex flex-wrap items-center justify-between gap-3\" data-kid=\"1-1-1-2-3-3-1\" data-name=\"third item card header row\">\n<h3 class=\"text-[1.35rem] leading-tight\" data-kid=\"1-1-1-2-3-3-1-1\" data-name=\"third item activity title\" style=\"font-family:'Playfair Display',Georgia,serif;font-weight:600;letter-spacing:-0.02em\">Shela Palm Villa</h3>\n<span class=\"inline-flex items-center gap-1.5 text-xs font-medium text-[#087e9f]\" data-kid=\"1-1-1-2-3-3-1-2\" data-name=\"third item mode badge (by the water)\">\n<span class=\"text-sm\" data-kid=\"1-1-1-2-3-3-1-2-1\" data-name=\"bed icon wrapper\"><i class=\"icon-bed-double\" data-kid=\"1-1-1-2-3-3-1-2-1-1\" data-name=\"bed icon\"></i></span>\n                By the water\n              </span>\n</div>\n<p class=\"mt-2 leading-6 text-[#18344b]/75\" data-kid=\"1-1-1-2-3-3-2\" data-name=\"third item stay description\">Rooms in Shela, the Old Town and Manda Island, from KES 5,000 a night.</p>\n<ul class=\"mt-3 flex flex-wrap items-center divide-x divide-[#e6eef4] text-[0.8rem] text-[#18344b]/70\" data-kid=\"1-1-1-2-3-3-3\" data-name=\"third item stay meta list\">\n<li class=\"pr-3\" data-kid=\"1-1-1-2-3-3-3-1\" data-name=\"third item price meta\">KES 12,500 a night</li>\n<li class=\"px-3\" data-kid=\"1-1-1-2-3-3-3-2\" data-name=\"third item capacity meta\">Sleeps 4</li>\n<li class=\"pl-3\" data-kid=\"1-1-1-2-3-3-3-3\" data-name=\"third item location meta\">Shela</li>\n</ul>\n<div class=\"mt-4 grid gap-3 sm:grid-cols-[1fr_112px_auto] sm:items-end\" data-kid=\"1-1-1-2-3-3-4\" data-name=\"stay search form row\">\n<label class=\"block\" data-kid=\"1-1-1-2-3-3-4-1\" data-name=\"area select field\">\n<span class=\"mb-1.5 block text-xs font-semibold text-[#18344b]/60\" data-kid=\"1-1-1-2-3-3-4-1-1\" data-name=\"area field label\">Area</span>\n<select class=\"h-11 w-full appearance-none rounded-md border border-[#cfe0e9] bg-[#fbfdff] px-3 text-sm text-[#18344b]\" data-kid=\"1-1-1-2-3-3-4-1-2\" data-name=\"area dropdown select\">\n<option data-kid=\"1-1-1-2-3-3-4-1-2-1\" data-name=\"area option Shela\">Shela</option>\n<option data-kid=\"1-1-1-2-3-3-4-1-2-2\" data-name=\"area option Lamu Old Town\">Lamu Old Town</option>\n<option data-kid=\"1-1-1-2-3-3-4-1-2-3\" data-name=\"area option Manda Island\">Manda Island</option>\n<option data-kid=\"1-1-1-2-3-3-4-1-2-4\" data-name=\"area option Kipungani\">Kipungani</option>\n</select>\n</label>\n<label class=\"block\" data-kid=\"1-1-1-2-3-3-4-2\" data-name=\"guests select field\">\n<span class=\"mb-1.5 block text-xs font-semibold text-[#18344b]/60\" data-kid=\"1-1-1-2-3-3-4-2-1\" data-name=\"guests field label\">Guests</span>\n<select class=\"h-11 w-full appearance-none rounded-md border border-[#cfe0e9] bg-[#fbfdff] px-3 text-sm text-[#18344b]\" data-kid=\"1-1-1-2-3-3-4-2-2\" data-name=\"guests dropdown select\">\n<option data-kid=\"1-1-1-2-3-3-4-2-2-1\" data-name=\"guests option 1\">1</option>\n<option data-kid=\"1-1-1-2-3-3-4-2-2-2\" data-name=\"guests option 2\">2</option>\n<option data-kid=\"1-1-1-2-3-3-4-2-2-3\" data-name=\"guests option 3\">3</option>\n<option data-kid=\"1-1-1-2-3-3-4-2-2-4\" data-name=\"guests option 4\">4</option>\n<option data-kid=\"1-1-1-2-3-3-4-2-2-5\" data-name=\"guests option 5+\">5+</option>\n</select>\n</label>\n<a class=\"inline-flex h-11 items-center justify-center gap-2 rounded-md bg-[#083b66] px-4 text-sm font-semibold text-[#f2f8fc] transition-colors hover:bg-[#062f52]\" data-kid=\"1-1-1-2-3-3-4-3\" data-name=\"find a stay button\" href=\"#places-to-stay\">\n                Find a stay\n                <span class=\"text-sm\" data-kid=\"1-1-1-2-3-3-4-3-1\" data-name=\"arrow icon wrapper\"><i class=\"icon-arrow-right\" data-kid=\"1-1-1-2-3-3-4-3-1-1\" data-name=\"right arrow icon\"></i></span>\n</a>\n</div>\n</div>\n</article>\n</div>\n</div>\n<div class=\"mt-10 flex flex-col gap-4 rounded-lg bg-[#eaf5fb] p-6 sm:flex-row sm:items-center sm:justify-between\" data-kid=\"1-1-2\" data-name=\"note and CTA banner\">\n<p class=\"max-w-xl text-sm leading-6 text-[#18344b]/85\" data-kid=\"1-1-2-1\" data-name=\"pickup note text\">Every tour leaves from the Lamu Town waterfront. Pickup point and departure time are confirmed when you book.</p>\n<a class=\"inline-flex h-11 shrink-0 items-center gap-2 rounded-md bg-[#083b66] px-5 text-sm font-semibold text-[#f2f8fc] transition-colors hover:bg-[#062f52]\" data-kid=\"1-1-2-2\" data-name=\"check dates button\" href=\"/booking.html\">\n        Check dates\n        <span class=\"text-sm\" data-kid=\"1-1-2-2-1\" data-name=\"arrow icon wrapper\"><i class=\"icon-arrow-right\" data-kid=\"1-1-2-2-1-1\" data-name=\"right arrow icon\"></i></span>\n</a>\n</div>\n</section>\n</div>\n",
