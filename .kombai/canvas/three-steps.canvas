      "html": "<style>\n@import url('https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;700;800&family=Playfair+Display:wght@600&display=swap');\n@import url('https://cdn.jsdelivr.net/npm/@phosphor-icons/web@2.1.2/src/regular/style.css');\n\n.step { background: #f2f8fc; color: #18344b; }\n.step[aria-selected=\"true\"] { background: #083b66; color: #f2f8fc; }\n.step[aria-selected=\"true\"] .step-sub { color: rgba(242, 248, 252, 0.72); }\n.step[aria-selected=\"true\"] .step-fact { color: #e3b548; }\n.step[aria-selected=\"true\"] .step-arrow { color: #e3b548; }\n.tab-body[hidden] { display: none; }\n</style>\n<div class=\"min-h-full w-full bg-[#e3b548] text-[#18344b]\" data-kid=\"1\" data-name=\"page background wrapper\" style=\"font-family:'DM Sans',ui-sans-serif,sans-serif\">\n<section class=\"mx-auto max-w-[1180px] p-4 sm:p-8\" data-kid=\"1-1\" data-name=\"main booking content section\">\n<div class=\"flex flex-wrap items-baseline justify-between gap-3\" data-kid=\"1-1-1\" data-name=\"section header row\">\n<h2 class=\"text-[2rem] leading-tight\" data-kid=\"1-1-1-1\" data-name=\"section heading text\" style=\"font-family:'Playfair Display',Georgia,serif;font-weight:600;letter-spacing:-0.03em\">Tours, sailings and rooms</h2>\n<span class=\"text-xs font-semibold text-[#18344b]/80\" data-kid=\"1-1-1-2\" data-name=\"currency note label\">Prices in KES</span>\n</div>\n<div class=\"mt-5 grid gap-2 lg:grid-cols-[1.45fr_1fr]\" data-kid=\"1-1-2\" data-name=\"two-column booking layout\">\n<div aria-label=\"Starting points\" class=\"flex flex-col gap-2\" data-kid=\"1-1-2-1\" data-name=\"starting points tab list\" role=\"tablist\">\n<button aria-selected=\"true\" class=\"step flex min-h-[56px] items-center gap-3 px-4 py-3 text-left transition-colors\" data-i=\"0\" data-kid=\"1-1-2-1-1\" data-name=\"step 1 tab button (Old Town Walk)\" role=\"tab\" style=\"clip-path:polygon(0 0,100% 0,100% calc(100% - 16px),calc(100% - 16px) 100%,0 100%)\" type=\"button\">\n<span class=\"flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-[#d9583f] text-sm font-extrabold text-white\" data-kid=\"1-1-2-1-1-1\" data-name=\"step number badge\">1</span>\n<span class=\"min-w-0 flex-1\" data-kid=\"1-1-2-1-1-2\" data-name=\"step title and subtitle container\">\n<span class=\"block truncate text-[0.95rem] font-semibold\" data-kid=\"1-1-2-1-1-2-1\" data-name=\"step primary title text\">Old Town Walk</span>\n<span class=\"step-sub block text-xs text-[#18344b]/65\" data-kid=\"1-1-2-1-1-2-2\" data-name=\"step subtitle location text\">Lamu Old Town</span>\n</span>\n<span class=\"step-fact shrink-0 text-xs font-semibold text-[#083b66]\" data-kid=\"1-1-2-1-1-3\" data-name=\"step duration fact text\">3 h</span>\n<span class=\"step-arrow shrink-0 text-base text-[#083b66]\" data-kid=\"1-1-2-1-1-4\" data-name=\"step arrow icon wrapper\"><i class=\"ph ph-arrow-right\" data-kid=\"1-1-2-1-1-4-1\" data-name=\"right arrow icon\"></i></span>\n</button>\n<span class=\"mx-auto h-2 w-px bg-[#18344b]/35\" data-kid=\"1-1-2-1-2\" data-name=\"vertical divider between steps\"></span>\n<button aria-selected=\"false\" class=\"step flex min-h-[56px] items-center gap-3 px-4 py-3 text-left transition-colors\" data-i=\"1\" data-kid=\"1-1-2-1-3\" data-name=\"step 2 tab button (Dhow Island Hopping)\" role=\"tab\" style=\"clip-path:polygon(0 0,100% 0,100% calc(100% - 16px),calc(100% - 16px) 100%,0 100%)\" type=\"button\">\n<span class=\"flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-[#d9583f] text-sm font-extrabold text-white\" data-kid=\"1-1-2-1-3-1\" data-name=\"step number badge\">2</span>\n<span class=\"min-w-0 flex-1\" data-kid=\"1-1-2-1-3-2\" data-name=\"step title and subtitle container\">\n<span class=\"block truncate text-[0.95rem] font-semibold\" data-kid=\"1-1-2-1-3-2-1\" data-name=\"step primary title text\">Dhow &amp; Island Hopping</span>\n<span class=\"step-sub block text-xs text-[#18344b]/65\" data-kid=\"1-1-2-1-3-2-2\" data-name=\"step subtitle location text\">Lamu Town waterfront</span>\n</span>\n<span class=\"step-fact shrink-0 text-xs font-semibold text-[#083b66]\" data-kid=\"1-1-2-1-3-3\" data-name=\"step duration fact text\">Half day</span>\n<span class=\"step-arrow shrink-0 text-base text-[#083b66]\" data-kid=\"1-1-2-1-3-4\" data-name=\"step arrow icon wrapper\"><i class=\"ph ph-arrow-right\" data-kid=\"1-1-2-1-3-4-1\" data-name=\"right arrow icon\"></i></span>\n</button>\n<span class=\"mx-auto h-2 w-px bg-[#18344b]/35\" data-kid=\"1-1-2-1-4\" data-name=\"vertical divider between steps\"></span>\n<button aria-selected=\"false\" class=\"step flex min-h-[56px] items-center gap-3 px-4 py-3 text-left transition-colors\" data-i=\"2\" data-kid=\"1-1-2-1-5\" data-name=\"step 3 tab button (Shela Palm Villa)\" role=\"tab\" style=\"clip-path:polygon(0 0,100% 0,100% calc(100% - 16px),calc(100% - 16px) 100%,0 100%)\" type=\"button\">\n<span class=\"flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-[#d9583f] text-sm font-extrabold text-white\" data-kid=\"1-1-2-1-5-1\" data-name=\"step number badge\">3</span>\n<span class=\"min-w-0 flex-1\" data-kid=\"1-1-2-1-5-2\" data-name=\"step title and subtitle container\">\n<span class=\"block truncate text-[0.95rem] font-semibold\" data-kid=\"1-1-2-1-5-2-1\" data-name=\"step primary title text\">Shela Palm Villa</span>\n<span class=\"step-sub block text-xs text-[#18344b]/65\" data-kid=\"1-1-2-1-5-2-2\" data-name=\"step subtitle location text\">Shela</span>\n</span>\n<span class=\"step-fact shrink-0 text-xs font-semibold text-[#083b66]\" data-kid=\"1-1-2-1-5-3\" data-name=\"step duration fact text\">Per night</span>\n<span class=\"step-arrow shrink-0 text-base text-[#083b66]\" data-kid=\"1-1-2-1-5-4\" data-name=\"step arrow icon wrapper\"><i class=\"ph ph-arrow-right\" data-kid=\"1-1-2-1-5-4-1\" data-name=\"right arrow icon\"></i></span>\n</button>\n</div>\n<div class=\"rounded-2xl bg-[#f2f8fc] p-4 text-[#18344b] ring-1 ring-[#18344b]/10\" data-kid=\"1-1-2-2\" data-name=\"tab detail card container\">\n<div class=\"tab-body\" data-i=\"0\" data-kid=\"1-1-2-2-1\" data-name=\"Old Town Walk tab body\">\n<div class=\"h-[104px] overflow-hidden rounded-xl\" data-kid=\"1-1-2-2-1-1\" data-name=\"tour photo container\">\n<img alt=\"Carved doorway in Lamu Old Town\" class=\"h-full w-full object-cover\" data-kid=\"1-1-2-2-1-1-1\" data-name=\"Lamu Old Town photo\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/images/Lamu_Fort_Museum's.jpg\"/>\n</div>\n<h3 class=\"mt-3 text-[1.15rem] leading-tight\" data-kid=\"1-1-2-2-1-2\" data-name=\"tour card title\" style=\"font-family:'Playfair Display',Georgia,serif;font-weight:600\">Old Town Walk</h3>\n<p class=\"mt-1 text-sm leading-6 text-[#18344b]/75\" data-kid=\"1-1-2-2-1-3\" data-name=\"tour card description\">Carved doors, coral-stone lanes and the fort museum. Meets at the Old Town waterfront.</p>\n<ul class=\"mt-2 flex flex-wrap gap-x-3 gap-y-1 text-xs text-[#18344b]/70\" data-kid=\"1-1-2-2-1-4\" data-name=\"tour facts list\">\n<li data-kid=\"1-1-2-2-1-4-1\" data-name=\"travel duration item\">3 hours</li>\n<li data-kid=\"1-1-2-2-1-4-2\" data-name=\"price per person item\">KES 3,500 per person</li>\n<li data-kid=\"1-1-2-2-1-4-3\" data-name=\"maximum guests item\">Max 12 guests</li>\n</ul>\n<a class=\"mt-3 flex h-10 items-center justify-center gap-2 rounded-lg bg-[#083b66] text-sm font-semibold text-white transition-colors hover:bg-[#062f52]\" data-kid=\"1-1-2-2-1-5\" data-name=\"read full history link button\" href=\"/tour-details.html?tour=old-town\">\n            Read the full history\n            <span class=\"text-sm\" data-kid=\"1-1-2-2-1-5-1\" data-name=\"link arrow icon wrapper\"><i class=\"ph ph-arrow-right\" data-kid=\"1-1-2-2-1-5-1-1\" data-name=\"right arrow icon\"></i></span>\n</a>\n</div>\n<div class=\"tab-body\" data-i=\"1\" data-kid=\"1-1-2-2-2\" data-name=\"Dhow Island Hopping tab body\" hidden=\"\">\n<div class=\"h-[104px] overflow-hidden rounded-xl\" data-kid=\"1-1-2-2-2-1\" data-name=\"tour photo container\">\n<img alt=\"Dhow under sail on the Lamu channel\" class=\"h-full w-full object-cover\" data-kid=\"1-1-2-2-2-1-1\" data-name=\"Dhow sailing photo\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/pictures/22151750.jpg\"/>\n</div>\n<h3 class=\"mt-3 text-[1.15rem] leading-tight\" data-kid=\"1-1-2-2-2-2\" data-name=\"tour card title\" style=\"font-family:'Playfair Display',Georgia,serif;font-weight:600\">Dhow &amp; Island Hopping</h3>\n<p class=\"mt-1 text-sm leading-6 text-[#18344b]/75\" data-kid=\"1-1-2-2-2-3\" data-name=\"tour card description\">A half day out of Lamu Town to the sandbanks, with the crew on the sail.</p>\n<div class=\"mt-2 flex items-end gap-2\" data-kid=\"1-1-2-2-2-4\" data-name=\"booking inputs row\">\n<label class=\"block flex-1\" data-kid=\"1-1-2-2-2-4-1\" data-name=\"departure date field\">\n<span class=\"mb-1 block text-[0.7rem] font-semibold text-[#18344b]/60\" data-kid=\"1-1-2-2-2-4-1-1\" data-name=\"departure field label\">Departure</span>\n<input class=\"js-gate h-10 w-full rounded-lg border border-[#18344b]/15 bg-white px-2.5 text-sm text-[#18344b]\" data-kid=\"1-1-2-2-2-4-1-2\" data-name=\"departure date input\" type=\"date\"/>\n</label>\n<label class=\"block w-[104px]\" data-kid=\"1-1-2-2-2-4-2\" data-name=\"guests field\">\n<span class=\"mb-1 block text-[0.7rem] font-semibold text-[#18344b]/60\" data-kid=\"1-1-2-2-2-4-2-1\" data-name=\"guests field label\">Guests</span>\n<select class=\"js-gate h-10 w-full appearance-none rounded-lg border border-[#18344b]/15 bg-white px-2.5 text-sm text-[#18344b]\" data-kid=\"1-1-2-2-2-4-2-2\" data-name=\"guests select dropdown\">\n<option data-kid=\"1-1-2-2-2-4-2-2-1\" data-name=\"select placeholder option\" value=\"\">Select</option>\n<option data-kid=\"1-1-2-2-2-4-2-2-2\" data-name=\"one guest option\" value=\"1\">1</option>\n<option data-kid=\"1-1-2-2-2-4-2-2-3\" data-name=\"two guest option\" value=\"2\">2</option>\n<option data-kid=\"1-1-2-2-2-4-2-2-4\" data-name=\"three guest option\" value=\"3\">3</option>\n<option data-kid=\"1-1-2-2-2-4-2-2-5\" data-name=\"four guest option\" value=\"4\">4</option>\n<option data-kid=\"1-1-2-2-2-4-2-2-6\" data-name=\"plus five guest option\" value=\"5\">5+</option>\n</select>\n</label>\n</div>\n<button class=\"js-cta mt-3 flex h-10 w-full items-center justify-center gap-2 rounded-lg bg-[#083b66] text-sm font-semibold text-white transition-colors hover:bg-[#062f52] disabled:cursor-not-allowed disabled:bg-[#18344b]/20 disabled:text-[#18344b]/45 disabled:hover:bg-[#18344b]/20\" data-dynamic=\"true\" data-kid=\"1-1-2-2-2-5\" data-name=\"check sailings call to action button\" data-reason=\"disabled attribute toggled by js-gate sync script\" disabled=\"\" type=\"button\">\n            Check sailings\n            <span class=\"text-sm\" data-kid=\"1-1-2-2-2-5-1\" data-name=\"button arrow icon wrapper\"><i class=\"ph ph-arrow-right\" data-kid=\"1-1-2-2-2-5-1-1\" data-name=\"right arrow icon\"></i></span>\n</button>\n</div>\n<div class=\"tab-body\" data-i=\"2\" data-kid=\"1-1-2-2-3\" data-name=\"Shela Palm Villa tab body\" hidden=\"\">\n<div class=\"h-[104px] overflow-hidden rounded-xl\" data-kid=\"1-1-2-2-3-1\" data-name=\"tour photo container\">\n<img alt=\"Shela shoreline and houses on Lamu island\" class=\"h-full w-full object-cover\" data-kid=\"1-1-2-2-3-1-1\" data-name=\"Shela shoreline photo\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/images/shela-lamu-kenya-01.jpg\"/>\n</div>\n<h3 class=\"mt-3 text-[1.15rem] leading-tight\" data-kid=\"1-1-2-2-3-2\" data-name=\"tour card title\" style=\"font-family:'Playfair Display',Georgia,serif;font-weight:600\">Shela Palm Villa</h3>\n<p class=\"mt-1 text-sm leading-6 text-[#18344b]/75\" data-kid=\"1-1-2-2-3-3\" data-name=\"tour card description\">Four guests, a short walk from the Shela shore. Rooms from KES 5,000 a night.</p>\n<div class=\"mt-2 flex items-end gap-2\" data-kid=\"1-1-2-2-3-4\" data-name=\"stay preference inputs row\">\n<label class=\"block flex-1\" data-kid=\"1-1-2-2-3-4-1\" data-name=\"area field\">\n<span class=\"mb-1 block text-[0.7rem] font-semibold text-[#18344b]/60\" data-kid=\"1-1-2-2-3-4-1-1\" data-name=\"area field label\">Area</span>\n<select class=\"js-gate h-10 w-full appearance-none rounded-lg border border-[#18344b]/15 bg-white px-2.5 text-sm text-[#18344b]\" data-kid=\"1-1-2-2-3-4-1-2\" data-name=\"area select dropdown\">\n<option data-kid=\"1-1-2-2-3-4-1-2-1\" data-name=\"select placeholder option\" value=\"\">Select</option>\n<option data-kid=\"1-1-2-2-3-4-1-2-2\" data-name=\"Shela area option\" value=\"shela\">Shela</option>\n<option data-kid=\"1-1-2-2-3-4-1-2-3\" data-name=\"Lamu Old Town area option\" value=\"old-town\">Lamu Old Town</option>\n<option data-kid=\"1-1-2-2-3-4-1-2-4\" data-name=\"Manda Island area option\" value=\"manda\">Manda Island</option>\n<option data-kid=\"1-1-2-2-3-4-1-2-5\" data-name=\"Kipungani area option\" value=\"kipungani\">Kipungani</option>\n</select>\n</label>\n<label class=\"block w-[104px]\" data-kid=\"1-1-2-2-3-4-2\" data-name=\"guests field\">\n<span class=\"mb-1 block text-[0.7rem] font-semibold text-[#18344b]/60\" data-kid=\"1-1-2-2-3-4-2-1\" data-name=\"guests field label\">Guests</span>\n<select class=\"js-gate h-10 w-full appearance-none rounded-lg border border-[#18344b]/15 bg-white px-2.5 text-sm text-[#18344b]\" data-kid=\"1-1-2-2-3-4-2-2\" data-name=\"guests select dropdown\">\n<option data-kid=\"1-1-2-2-3-4-2-2-1\" data-name=\"select placeholder option\" value=\"\">Select</option>\n<option data-kid=\"1-1-2-2-3-4-2-2-2\" data-name=\"one guest option\" value=\"1\">1</option>\n<option data-kid=\"1-1-2-2-3-4-2-2-3\" data-name=\"two guest option\" value=\"2\">2</option>\n<option data-kid=\"1-1-2-2-3-4-2-2-4\" data-name=\"three guest option\" value=\"3\">3</option>\n<option data-kid=\"1-1-2-2-3-4-2-2-5\" data-name=\"four guest option\" value=\"4\">4</option>\n<option data-kid=\"1-1-2-2-3-4-2-2-6\" data-name=\"five plus guest option\" value=\"5\">5+</option>\n</select>\n</label>\n</div>\n<button class=\"js-cta mt-3 flex h-10 w-full items-center justify-center gap-2 rounded-lg bg-[#083b66] text-sm font-semibold text-white transition-colors hover:bg-[#062f52] disabled:cursor-not-allowed disabled:bg-[#18344b]/20 disabled:text-[#18344b]/45 disabled:hover:bg-[#18344b]/20\" data-dynamic=\"true\" data-kid=\"1-1-2-2-3-5\" data-name=\"find a stay call to action button\" data-reason=\"disabled attribute toggled by js-gate sync script\" disabled=\"\" type=\"button\">\n            Find a stay\n            <span class=\"text-sm\" data-kid=\"1-1-2-2-3-5-1\" data-name=\"button arrow icon wrapper\"><i class=\"ph ph-arrow-right\" data-kid=\"1-1-2-2-3-5-1-1\" data-name=\"right arrow icon\"></i></span>\n</button>\n</div>\n</div>\n</div>\n<div class=\"relative mt-2 overflow-hidden rounded-2xl bg-[#083b66] px-5 pb-4 pt-5 text-[#f2f8fc]\" data-kid=\"1-1-3\" data-name=\"booking policy banner card\">\n<span class=\"absolute inset-x-6 top-1.5 border-t border-dashed border-[#f2f8fc]/35\" data-kid=\"1-1-3-1\" data-name=\"dashed top border decoration\"></span>\n<div class=\"flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between\" data-kid=\"1-1-3-2\" data-name=\"banner inner content row\">\n<p class=\"max-w-lg text-sm leading-6 text-[#f2f8fc]/80\" data-kid=\"1-1-3-2-1\" data-name=\"payment policy text\">A booking holds your place on the departure. Payment is by M-Pesa; a full booking is confirmed once the payment clears.</p>\n<a class=\"inline-flex h-10 shrink-0 items-center gap-2 rounded-full bg-[#e3b548] px-5 text-sm font-semibold text-[#18344b] transition-colors hover:bg-[#f0c862]\" data-kid=\"1-1-3-2-2\" data-name=\"all departures link button\" href=\"/tours.html\">\n          All departures\n          <span class=\"text-sm\" data-kid=\"1-1-3-2-2-1\" data-name=\"link arrow icon wrapper\"><i class=\"ph ph-arrow-right\" data-kid=\"1-1-3-2-2-1-1\" data-name=\"right arrow icon\"></i></span>\n</a>\n</div>\n</div>\n</section>\n</div>\n<script>\n(function () {\n  var steps = Array.prototype.slice.call(document.querySelectorAll('.step'));\n  var bodies = Array.prototype.slice.call(document.querySelectorAll('.tab-body'));\n\n  function select(index) {\n    steps.forEach(function (step, i) {\n      step.setAttribute('aria-selected', i === index ? 'true' : 'false');\n    });\n    bodies.forEach(function (body, i) {\n      if (i === index) {\n        body.removeAttribute('hidden');\n      } else {\n        body.setAttribute('hidden', '');\n      }\n    });\n  }\n\n  steps.forEach(function (step, index) {\n    step.addEventListener('click', function () { select(index); });\n  });\n\n  bodies.forEach(function (body) {\n    var gates = Array.prototype.slice.call(body.querySelectorAll('.js-gate'));\n    var cta = body.querySelector('.js-cta');\n    if (!gates.length || !cta) return;\n    function sync() {\n      var ready = gates.every(function (gate) { return gate.value !== ''; });\n      cta.disabled = !ready;\n    }\n    gates.forEach(function (gate) {\n      gate.addEventListener('change', sync);\n      gate.addEventListener('input', sync);\n    });\n  });\n})();\n</script>\n",
      "comments": [],
      "created": "2026-10-29T19:25:10.011529+00:00",
      "modified": "2026-10-29T19:34:47.581085+00:00",
