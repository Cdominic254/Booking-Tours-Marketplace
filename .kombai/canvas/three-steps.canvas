      "html": "<style>\n@import url('https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;700&family=Fira+Code:wght@500&family=Playfair+Display:wght@600&display=swap');\n@import url('https://cdn.jsdelivr.net/npm/@tabler/icons-webfont@3.48.0/dist/tabler-icons.min.css');\n\n.panel-body { opacity: 0; pointer-events: none; }\n.panel.is-open .panel-body { opacity: 1; pointer-events: auto; }\n.panel-verb { opacity: 1; }\n.panel.is-open .panel-verb { opacity: 0; }\n\n@media (max-width: 639px) {\n  .panel-body { position: static !important; opacity: 1 !important; pointer-events: auto !important; }\n  .panel-verb { display: none !important; }\n}\n</style>\n<div class=\"min-h-full w-full bg-[#06385f] text-[#f2f8fc]\" data-kid=\"1\" data-name=\"page layout container\" style=\"font-family:'DM Sans',ui-sans-serif,sans-serif\">\n<section class=\"mx-auto max-w-[1180px] px-5 py-20 sm:px-8\" data-kid=\"1-1\" data-name=\"tours section container\">\n<div class=\"flex flex-wrap items-baseline justify-between gap-4\" data-kid=\"1-1-1\" data-name=\"section header with title and link\">\n<h2 class=\"text-[1.9rem] leading-tight\" data-kid=\"1-1-1-1\" data-name=\"section headline text\" style=\"font-family:'Playfair Display',Georgia,serif;font-weight:600;letter-spacing:-0.03em\">Where to begin</h2>\n<a class=\"inline-flex items-center gap-1.5 text-sm font-medium text-[#e3b548] hover:underline underline-offset-4\" data-kid=\"1-1-1-2\" data-name=\"all departures link\" href=\"/tours.html\">\n        All departures\n        <span class=\"text-sm\" data-kid=\"1-1-1-2-1\" data-name=\"arrow icon span\"><i class=\"ti ti-arrow-right\" data-kid=\"1-1-1-2-1-1\" data-name=\"arrow right icon\"></i></span>\n</a>\n</div>\n<div class=\"mt-8 flex flex-col gap-2 sm:h-[400px] sm:flex-row\" data-kid=\"1-1-2\" data-name=\"expanding panel row container\">\n<div aria-expanded=\"true\" class=\"panel is-open relative cursor-pointer overflow-hidden bg-[#083b66] text-left sm:min-w-0\" data-dynamic=\"true\" data-i=\"0\" data-kid=\"1-1-2-1\" data-name=\"Old Town tour expandable panel\" data-reason=\"flex-grow restyled by script on panel toggle\" role=\"button\" style=\"flex-grow:1.9;flex-basis:0\" tabindex=\"0\">\n<img alt=\"Carved doorway in Lamu Old Town\" class=\"absolute inset-0 h-full w-full object-cover opacity-55\" data-kid=\"1-1-2-1-1\" data-name=\"Lamu Old Town background image\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/images/Lamu_Fort_Museum's.jpg\"/>\n<span class=\"absolute inset-0 bg-gradient-to-t from-[#06385f] via-[#06385f]/55 to-[#06385f]/15\" data-kid=\"1-1-2-1-2\" data-name=\"panel gradient overlay\"></span>\n<span class=\"panel-verb absolute bottom-6 left-5 text-xs font-medium uppercase tracking-[0.22em] text-[#f2f8fc]/85 transition-opacity duration-300\" data-dynamic=\"true\" data-kid=\"1-1-2-1-3\" data-name=\"panel collapsed verb label (Walk)\" data-reason=\"opacity toggled by script via panel is-open state\" style=\"writing-mode:vertical-rl;transform:rotate(180deg)\">Walk</span>\n<div class=\"panel-body absolute inset-x-0 bottom-0 bg-[#083b66] p-6 ring-1 ring-inset ring-[#7ee2e1]/25 transition-opacity duration-300\" data-dynamic=\"true\" data-kid=\"1-1-2-1-4\" data-name=\"panel expanded content body\" data-reason=\"opacity toggled by script via panel is-open state\">\n<span class=\"block h-[120px] sm:hidden\" data-kid=\"1-1-2-1-4-1\" data-name=\"mobile spacer element\"></span>\n<div class=\"flex items-center gap-3\" data-kid=\"1-1-2-1-4-2\" data-name=\"panel title row\">\n<span class=\"flex h-9 w-9 shrink-0 items-center justify-center rounded-full bg-[#e3b548] text-[1.05rem] font-medium text-[#18344b]\" data-kid=\"1-1-2-1-4-2-1\" data-name=\"panel number badge (01)\" style=\"font-family:'Fira Code',monospace\">01</span>\n<h3 class=\"text-[1.55rem] leading-tight\" data-kid=\"1-1-2-1-4-2-2\" data-name=\"panel title text (Old Town Walk)\" style=\"font-family:'Playfair Display',Georgia,serif;font-weight:600;letter-spacing:-0.02em\">Old Town Walk</h3>\n</div>\n<p class=\"mt-2.5 text-sm leading-6 text-[#f2f8fc]/80\" data-kid=\"1-1-2-1-4-3\" data-name=\"panel description text\">Carved doors, coral-stone lanes and the fort museum, on foot from the waterfront.</p>\n<ul class=\"mt-3 flex flex-wrap items-center gap-x-4 gap-y-1 text-xs text-[#7ee2e1]/85\" data-kid=\"1-1-2-1-4-4\" data-name=\"panel facts list\">\n<li class=\"inline-flex items-center gap-1.5\" data-kid=\"1-1-2-1-4-4-1\" data-name=\"duration fact item\"><span class=\"text-sm\" data-kid=\"1-1-2-1-4-4-1-1\" data-name=\"icon wrapper span\"><i class=\"ti ti-clock\" data-kid=\"1-1-2-1-4-4-1-1-1\" data-name=\"clock icon\"></i></span>3 hours</li>\n<li class=\"inline-flex items-center gap-1.5\" data-kid=\"1-1-2-1-4-4-2\" data-name=\"price fact item\"><span class=\"text-sm\" data-kid=\"1-1-2-1-4-4-2-1\" data-name=\"icon wrapper span\"><i class=\"ti ti-coin\" data-kid=\"1-1-2-1-4-4-2-1-1\" data-name=\"coin icon\"></i></span>From KES 3,500</li>\n<li class=\"inline-flex items-center gap-1.5\" data-kid=\"1-1-2-1-4-4-3\" data-name=\"guests fact item\"><span class=\"text-sm\" data-kid=\"1-1-2-1-4-4-3-1\" data-name=\"icon wrapper span\"><i class=\"ti ti-users\" data-kid=\"1-1-2-1-4-4-3-1-1\" data-name=\"users icon\"></i></span>Max 12 guests</li>\n</ul>\n<a class=\"mt-4 inline-flex h-11 items-center gap-2 bg-[#d9583f] px-5 text-sm font-semibold text-white transition-colors hover:bg-[#c44b33]\" data-kid=\"1-1-2-1-4-5\" data-name=\"panel call-to-action button link\" href=\"/tour-details.html?tour=old-town\">\n            Read the old town guide\n            <span class=\"text-sm\" data-kid=\"1-1-2-1-4-5-1\" data-name=\"arrow icon span\"><i class=\"ti ti-arrow-right\" data-kid=\"1-1-2-1-4-5-1-1\" data-name=\"arrow right icon\"></i></span>\n</a>\n</div>\n</div>\n<div aria-expanded=\"false\" class=\"panel relative cursor-pointer overflow-hidden bg-[#083b66] text-left sm:min-w-0\" data-dynamic=\"true\" data-i=\"1\" data-kid=\"1-1-2-2\" data-name=\"Dhow tour expandable panel\" data-reason=\"flex-grow restyled by script on panel toggle\" role=\"button\" style=\"flex-grow:1;flex-basis:0\" tabindex=\"0\">\n<img alt=\"Dhow under sail on the Lamu channel\" class=\"absolute inset-0 h-full w-full object-cover opacity-55\" data-kid=\"1-1-2-2-1\" data-name=\"Dhow sailing background image\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/pictures/22151750.jpg\"/>\n<span class=\"absolute inset-0 bg-gradient-to-t from-[#06385f] via-[#06385f]/55 to-[#06385f]/15\" data-kid=\"1-1-2-2-2\" data-name=\"panel gradient overlay\"></span>\n<span class=\"panel-verb absolute bottom-6 left-5 text-xs font-medium uppercase tracking-[0.22em] text-[#f2f8fc]/85 transition-opacity duration-300\" data-dynamic=\"true\" data-kid=\"1-1-2-2-3\" data-name=\"panel collapsed verb label (Sail)\" data-reason=\"opacity toggled by script via panel is-open state\" style=\"writing-mode:vertical-rl;transform:rotate(180deg)\">Sail</span>\n<div class=\"panel-body absolute inset-x-0 bottom-0 bg-[#083b66] p-6 ring-1 ring-inset ring-[#7ee2e1]/25 transition-opacity duration-300\" data-dynamic=\"true\" data-kid=\"1-1-2-2-4\" data-name=\"panel expanded content body\" data-reason=\"opacity toggled by script via panel is-open state\">\n<span class=\"block h-[120px] sm:hidden\" data-kid=\"1-1-2-2-4-1\" data-name=\"mobile spacer element\"></span>\n<div class=\"flex items-center gap-3\" data-kid=\"1-1-2-2-4-2\" data-name=\"panel title row\">\n<span class=\"flex h-9 w-9 shrink-0 items-center justify-center rounded-full bg-[#e3b548] text-[1.05rem] font-medium text-[#18344b]\" data-kid=\"1-1-2-2-4-2-1\" data-name=\"panel number badge (02)\" style=\"font-family:'Fira Code',monospace\">02</span>\n<h3 class=\"text-[1.55rem] leading-tight\" data-kid=\"1-1-2-2-4-2-2\" data-name=\"panel title text (Dhow &amp; Island Hopping)\" style=\"font-family:'Playfair Display',Georgia,serif;font-weight:600;letter-spacing:-0.02em\">Dhow &amp; Island Hopping</h3>\n</div>\n<p class=\"mt-2.5 text-sm leading-6 text-[#f2f8fc]/80\" data-kid=\"1-1-2-2-4-3\" data-name=\"panel description text\">A half day out of Lamu Town to the sandbanks and back, with the crew on the sail.</p>\n<ul class=\"mt-3 flex flex-wrap items-center gap-x-4 gap-y-1 text-xs text-[#7ee2e1]/85\" data-kid=\"1-1-2-2-4-4\" data-name=\"panel facts list\">\n<li class=\"inline-flex items-center gap-1.5\" data-kid=\"1-1-2-2-4-4-1\" data-name=\"duration fact item\"><span class=\"text-sm\" data-kid=\"1-1-2-2-4-4-1-1\" data-name=\"icon wrapper span\"><i class=\"ti ti-clock\" data-kid=\"1-1-2-2-4-4-1-1-1\" data-name=\"clock icon\"></i></span>Half day</li>\n<li class=\"inline-flex items-center gap-1.5\" data-kid=\"1-1-2-2-4-4-2\" data-name=\"price fact item\"><span class=\"text-sm\" data-kid=\"1-1-2-2-4-4-2-1\" data-name=\"icon wrapper span\"><i class=\"ti ti-coin\" data-kid=\"1-1-2-2-4-4-2-1-1\" data-name=\"coin icon\"></i></span>KES 8,500</li>\n<li class=\"inline-flex items-center gap-1.5\" data-kid=\"1-1-2-2-4-4-3\" data-name=\"guests fact item\"><span class=\"text-sm\" data-kid=\"1-1-2-2-4-4-3-1\" data-name=\"icon wrapper span\"><i class=\"ti ti-users\" data-kid=\"1-1-2-2-4-4-3-1-1\" data-name=\"users icon\"></i></span>Max 12 guests</li>\n</ul>\n<a class=\"mt-4 inline-flex h-11 items-center gap-2 bg-[#d9583f] px-5 text-sm font-semibold text-white transition-colors hover:bg-[#c44b33]\" data-kid=\"1-1-2-2-4-5\" data-name=\"panel call-to-action button link\" href=\"/booking.html?tour=dhow\">\n            See sailings and dates\n            <span class=\"text-sm\" data-kid=\"1-1-2-2-4-5-1\" data-name=\"arrow icon span\"><i class=\"ti ti-arrow-right\" data-kid=\"1-1-2-2-4-5-1-1\" data-name=\"arrow right icon\"></i></span>\n</a>\n</div>\n</div>\n<div aria-expanded=\"false\" class=\"panel relative cursor-pointer overflow-hidden bg-[#083b66] text-left sm:min-w-0\" data-dynamic=\"true\" data-i=\"2\" data-kid=\"1-1-2-3\" data-name=\"Stay lodging expandable panel\" data-reason=\"flex-grow restyled by script on panel toggle\" role=\"button\" style=\"flex-grow:1;flex-basis:0\" tabindex=\"0\">\n<img alt=\"Shela shoreline and houses on Lamu island\" class=\"absolute inset-0 h-full w-full object-cover opacity-55\" data-kid=\"1-1-2-3-1\" data-name=\"Shela shoreline background image\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/images/shela-lamu-kenya-01.jpg\"/>\n<span class=\"absolute inset-0 bg-gradient-to-t from-[#06385f] via-[#06385f]/55 to-[#06385f]/15\" data-kid=\"1-1-2-3-2\" data-name=\"panel gradient overlay\"></span>\n<span class=\"panel-verb absolute bottom-6 left-5 text-xs font-medium uppercase tracking-[0.22em] text-[#f2f8fc]/85 transition-opacity duration-300\" data-dynamic=\"true\" data-kid=\"1-1-2-3-3\" data-name=\"panel collapsed verb label (Stay)\" data-reason=\"opacity toggled by script via panel is-open state\" style=\"writing-mode:vertical-rl;transform:rotate(180deg)\">Stay</span>\n<div class=\"panel-body absolute inset-x-0 bottom-0 bg-[#083b66] p-6 ring-1 ring-inset ring-[#7ee2e1]/25 transition-opacity duration-300\" data-dynamic=\"true\" data-kid=\"1-1-2-3-4\" data-name=\"panel expanded content body\" data-reason=\"opacity toggled by script via panel is-open state\">\n<span class=\"block h-[120px] sm:hidden\" data-kid=\"1-1-2-3-4-1\" data-name=\"mobile spacer element\"></span>\n<div class=\"flex items-center gap-3\" data-kid=\"1-1-2-3-4-2\" data-name=\"panel title row\">\n<span class=\"flex h-9 w-9 shrink-0 items-center justify-center rounded-full bg-[#e3b548] text-[1.05rem] font-medium text-[#18344b]\" data-kid=\"1-1-2-3-4-2-1\" data-name=\"panel number badge (03)\" style=\"font-family:'Fira Code',monospace\">03</span>\n<h3 class=\"text-[1.55rem] leading-tight\" data-kid=\"1-1-2-3-4-2-2\" data-name=\"panel title text (Shela Palm Villa)\" style=\"font-family:'Playfair Display',Georgia,serif;font-weight:600;letter-spacing:-0.02em\">Shela Palm Villa</h3>\n</div>\n<p class=\"mt-2.5 text-sm leading-6 text-[#f2f8fc]/80\" data-kid=\"1-1-2-3-4-3\" data-name=\"panel description text\">Rooms in Shela, the Old Town and Manda Island, from KES 5,000 a night.</p>\n<div class=\"mt-3 flex items-end gap-2\" data-kid=\"1-1-2-3-4-4\" data-name=\"stay search form row\">\n<label class=\"block flex-1\" data-kid=\"1-1-2-3-4-4-1\" data-name=\"area select field group\">\n<span class=\"mb-1 block text-[0.7rem] font-medium text-[#7ee2e1]/85\" data-kid=\"1-1-2-3-4-4-1-1\" data-name=\"field label (Area)\">Area</span>\n<select class=\"h-11 w-full appearance-none border border-[#7ee2e1]/35 bg-[#0b6488] px-2.5 text-sm text-[#f2f8fc]\" data-kid=\"1-1-2-3-4-4-1-2\" data-name=\"area dropdown select\">\n<option data-kid=\"1-1-2-3-4-4-1-2-1\" data-name=\"dropdown option (Shela)\">Shela</option>\n<option data-kid=\"1-1-2-3-4-4-1-2-2\" data-name=\"dropdown option (Lamu Old Town)\">Lamu Old Town</option>\n<option data-kid=\"1-1-2-3-4-4-1-2-3\" data-name=\"dropdown option (Manda Island)\">Manda Island</option>\n<option data-kid=\"1-1-2-3-4-4-1-2-4\" data-name=\"dropdown option (Kipungani)\">Kipungani</option>\n</select>\n</label>\n<label class=\"block w-[92px]\" data-kid=\"1-1-2-3-4-4-2\" data-name=\"guests select field group\">\n<span class=\"mb-1 block text-[0.7rem] font-medium text-[#7ee2e1]/85\" data-kid=\"1-1-2-3-4-4-2-1\" data-name=\"field label (Guests)\">Guests</span>\n<select class=\"h-11 w-full appearance-none border border-[#7ee2e1]/35 bg-[#0b6488] px-2.5 text-sm text-[#f2f8fc]\" data-kid=\"1-1-2-3-4-4-2-2\" data-name=\"guests dropdown select\">\n<option data-kid=\"1-1-2-3-4-4-2-2-1\" data-name=\"dropdown option (1 guest)\">1</option>\n<option data-kid=\"1-1-2-3-4-4-2-2-2\" data-name=\"dropdown option (2 guests)\">2</option>\n<option data-kid=\"1-1-2-3-4-4-2-2-3\" data-name=\"dropdown option (3 guests)\">3</option>\n<option data-kid=\"1-1-2-3-4-4-2-2-4\" data-name=\"dropdown option (4 guests)\">4</option>\n<option data-kid=\"1-1-2-3-4-4-2-2-5\" data-name=\"dropdown option (5+ guests)\">5+</option>\n</select>\n</label>\n<a class=\"inline-flex h-11 shrink-0 items-center gap-1.5 bg-[#d9583f] px-4 text-sm font-semibold text-white transition-colors hover:bg-[#c44b33]\" data-kid=\"1-1-2-3-4-4-3\" data-name=\"find a stay button link\" href=\"#places-to-stay\">\n              Find a stay\n              <span class=\"text-sm\" data-kid=\"1-1-2-3-4-4-3-1\" data-name=\"arrow icon span\"><i class=\"ti ti-arrow-right\" data-kid=\"1-1-2-3-4-4-3-1-1\" data-name=\"arrow right icon\"></i></span>\n</a>\n</div>\n</div>\n</div>\n</div>\n<div class=\"mt-6 flex flex-wrap items-center gap-x-6 gap-y-2 text-xs text-[#f2f8fc]/65\" data-kid=\"1-1-3\" data-name=\"section footer meta row\">\n<span class=\"inline-flex items-center gap-1.5\" data-kid=\"1-1-3-1\" data-name=\"location meta item\"><span class=\"text-sm\" data-kid=\"1-1-3-1-1\" data-name=\"icon wrapper span\"><i class=\"ti ti-map-pin\" data-kid=\"1-1-3-1-1-1\" data-name=\"map pin icon\"></i></span>Lamu Town waterfront</span>\n<span class=\"inline-flex items-center gap-1.5\" data-kid=\"1-1-3-2\" data-name=\"departure timing meta item\"><span class=\"text-sm\" data-kid=\"1-1-3-2-1\" data-name=\"icon wrapper span\"><i class=\"ti ti-clock\" data-kid=\"1-1-3-2-1-1\" data-name=\"clock icon\"></i></span>Departures confirmed on booking</span>\n</div>\n</section>\n</div>\n<script>\n(function () {\n  var panels = Array.prototype.slice.call(document.querySelectorAll('.panel'));\n  function open(index) {\n    panels.forEach(function (panel, i) {\n      var on = i === index;\n      panel.classList.toggle('is-open', on);\n      panel.setAttribute('aria-expanded', on ? 'true' : 'false');\n      if (window.innerWidth >= 640) {\n        panel.style.flexGrow = on ? '1.9' : '1';\n      }\n    });\n  }\n  panels.forEach(function (panel, index) {\n    panel.addEventListener('click', function (event) {\n      if (event.target.closest('select, a')) return;\n      open(index);\n    });\n    panel.addEventListener('keydown', function (event) {\n      if (event.key === 'Enter' || event.key === ' ') {\n        event.preventDefault();\n        open(index);\n      }\n    });\n  });\n})();\n</script>\n",
